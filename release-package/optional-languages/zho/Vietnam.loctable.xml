        <Row>
          <Cell>
            <Data ss:Type="String">#VI_WE_MAT49D</Data>
          </Cell>
          <Cell>
            <Data ss:Type="String">一款法国制造的全自动机枪，&#10;9x19毫米，没啥特别的。&#10;#DMG;低物理伤害&#10;#ROF;600发每分钟</Data>
